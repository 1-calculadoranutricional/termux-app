<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App / Package Icon (Play Store squircle) -->
        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#2A2B2E">

            <ImageView
                android:id="@+id/package_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </androidx.cardview.widget.CardView>

        <!-- Title, Category, Rating & Description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/package_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#E3E3E3" />

            <TextView
                android:id="@+id/package_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#9AA0A6"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/package_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#9AA0A6"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Action Buttons Container (Side by side on the same row, no line wrap) -->
        <LinearLayout
            android:id="@+id/package_buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Secondary Button: Desinstalar (Pill shaped, Transparent Background, #AECBFA text, singleLine) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/package_secondary_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:lines="1"
                app:cornerRadius="18dp"
                app:strokeWidth="1dp"
                app:strokeColor="#747775"
                app:backgroundTint="@android:color/transparent"
                android:textColor="#AECBFA"
                app:rippleColor="#26AECBFA"
                android:visibility="gone" />

            <!-- Primary Action Button: Instalar / Actualizar (Pill shaped, #AECBFA Background, #001D35 text, singleLine) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/package_action_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:lines="1"
                app:cornerRadius="18dp"
                app:backgroundTint="#AECBFA"
                android:textColor="#001D35"
                app:rippleColor="#33001D35" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#1E1F20" />

</LinearLayout>
